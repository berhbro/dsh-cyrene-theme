{
  "name": "dsh-cyrene-theme",
  "version": "0.5.1",
  "description": "昔涟（Cyrene）主题：粉白渐变毛玻璃 UI + 侧边栏可编辑的人格设定 + 表情包 / 背景图 / 长期记忆 / 世界书管理 | A Cyrene (Honkai: Star Rail) theme for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "stickers.json",
    "Background",
    "meme/*.png",
    "meme/*.jpeg",
    "tools/*.mjs",
    "test",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "persona"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berhbro/dsh-cyrene-theme.git"
  },
  "homepage": "https://github.com/berhbro/dsh-cyrene-theme#readme",
  "bugs": {
    "url": "https://github.com/berhbro/dsh-cyrene-theme/issues"
  },
  "author": "berhbro",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
